<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:focusableInTouchMode="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#6200EE"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="나이 계산기"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/editBirthYear"
                android:text="태어난 연도를 입력하세요."
                android:textColor="#555555"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editBirthYear"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="출생 연도를 입력하세요."
                android:gravity="center"
                android:inputType="number"
                android:digits="0123456789"
                android:maxLength="4"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalculateAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6200EE"
                android:text="나이 계산"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/editAge"
                android:text="당신의 나이를 입력하세요."
                android:textColor="#555555"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editAge"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="나이를 입력하세요."
                android:gravity="center"
                android:inputType="number"
                android:digits="0123456789"
                android:maxLength="3"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalculateYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6200EE"
                android:text="태어난 해 계산"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>